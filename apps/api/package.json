{
  "name": "@arrowcast/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:import-participants": "tsx --env-file-if-exists=../../.env src/scripts/import-participants.ts",
    "auth:setup": "tsx src/modules/auth/setup.ts",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/server.js"
  },
  "dependencies": {
    "@arrowcast/contracts": "^0.0.0",
    "@arrowcast/scoring": "^0.0.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/jwt": "10.2.5",
    "@fastify/rate-limit": "11.2.1",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.4",
    "exceljs": "^4.4.0",
    "fastify": "5.12.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
