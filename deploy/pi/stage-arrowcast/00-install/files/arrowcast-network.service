[Unit]
Description=Arrowcast Ethernet priority and Wi-Fi settings broker
Requires=NetworkManager.service
After=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/arrowcast/network.py
RuntimeDirectory=arrowcast-network
RuntimeDirectoryMode=0755
UMask=0077
Restart=on-failure
RestartSec=3
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/etc/NetworkManager/system-connections

[Install]
WantedBy=multi-user.target
